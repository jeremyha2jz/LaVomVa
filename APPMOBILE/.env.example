# Copia a .env.local para desarrollo; no versiones ese archivo.
# Vite reenvía /api a http://localhost:5007 en desarrollo.
VITE_API_URL=/api
# Producción: define la URL HTTPS real del backend terminada en /api
# antes de npm run build. Reinicia Vite tras cambiar el entorno.
# Las variables VITE_* son públicas: nunca incluyas secretos.
