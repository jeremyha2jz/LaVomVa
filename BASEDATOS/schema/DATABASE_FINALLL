-- 10. FUNCIONES Y TRIGGERS
-- =====================================================================

-- 10.1 actualizado_en automático
CREATE OR REPLACE FUNCTION fn_actualizar_timestamp()
RETURNS TRIGGER AS $$
BEGIN
    NEW.actualizado_en = CURRENT_TIMESTAMP;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_usuarios_actualizado BEFORE UPDATE ON usuarios FOR EACH ROW EXECUTE FUNCTION fn_actualizar_timestamp();
CREATE TRIGGER trg_empleados_actualizado BEFORE UPDATE ON empleados FOR EACH ROW EXECUTE FUNCTION fn_actualizar_timestamp();
CREATE TRIGGER trg_vehiculos_actualizado BEFORE UPDATE ON vehiculos FOR EACH ROW EXECUTE FUNCTION fn_actualizar_timestamp();
CREATE TRIGGER trg_solicitudes_actualizado BEFORE UPDATE ON solicitudes_combustible FOR EACH ROW EXECUTE FUNCTION fn_actualizar_timestamp();

-- 10.2 Numeración de tickets (RF-08), con bloqueo de fila para evitar
-- duplicados si dos tickets se crean al mismo tiempo.
CREATE OR REPLACE FUNCTION fn_generar_numero_ticket()
RETURNS VARCHAR AS $$
DECLARE
    v_prefijo VARCHAR(20);
    v_reinicio BOOLEAN;
    v_secuencia BIGINT;
    v_anio INTEGER;
BEGIN
    SELECT prefijo, reinicio_anual, secuencia_actual, anio_secuencia
      INTO v_prefijo, v_reinicio, v_secuencia, v_anio
    FROM configuracion_tickets
    ORDER BY id_configuracion LIMIT 1
    FOR UPDATE;

    IF v_reinicio = TRUE AND v_anio <> EXTRACT(YEAR FROM CURRENT_DATE)::INTEGER THEN
        v_secuencia := 0;
        v_anio := EXTRACT(YEAR FROM CURRENT_DATE)::INTEGER;
    END IF;

    v_secuencia := v_secuencia + 1;

    UPDATE configuracion_tickets
       SET secuencia_actual = v_secuencia, anio_secuencia = v_anio, actualizado_en = CURRENT_TIMESTAMP
     WHERE id_configuracion = (SELECT id_configuracion FROM configuracion_tickets ORDER BY id_configuracion LIMIT 1);

    RETURN v_prefijo || '-' || v_anio || '-' || LPAD(v_secuencia::TEXT, 6, '0');
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION fn_ticket_numero_automatico()
RETURNS TRIGGER AS $$
BEGIN
    IF NEW.numero_secuencial IS NULL OR BTRIM(NEW.numero_secuencial) = '' THEN
        NEW.numero_secuencial := fn_generar_numero_ticket();
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_ticket_numero_automatico
BEFORE INSERT ON tickets
FOR EACH ROW EXECUTE FUNCTION fn_ticket_numero_automatico();

-- 10.3 Núcleo del inventario: valida y aplica CUALQUIER movimiento
-- (entrada, salida, ajuste, merma, transferencia) contra el tanque.
CREATE OR REPLACE FUNCTION fn_aplicar_movimiento_inventario()
RETURNS TRIGGER AS $$
DECLARE
    v_existencia NUMERIC(12,2);
    v_capacidad NUMERIC(12,2);
    v_nueva NUMERIC(12,2);
BEGIN
    SELECT existencia_actual_galones, capacidad_galones
      INTO v_existencia, v_capacidad
    FROM tanques WHERE id_tanque = NEW.id_tanque
    FOR UPDATE;

    IF NEW.tipo_movimiento IN ('ENTRADA','AJUSTE_POSITIVO','TRANSFERENCIA_ENTRADA') THEN
        v_nueva := v_existencia + NEW.cantidad_galones;
    ELSE
        v_nueva := v_existencia - NEW.cantidad_galones;
    END IF;

    IF v_nueva < 0 THEN
        RAISE EXCEPTION 'Inventario insuficiente en el tanque %', NEW.id_tanque;
    END IF;
    IF v_nueva > v_capacidad THEN
        RAISE EXCEPTION 'El movimiento excede la capacidad del tanque %', NEW.id_tanque;
    END IF;

    NEW.existencia_anterior := v_existencia;
    NEW.existencia_nueva := v_nueva;

    UPDATE tanques SET existencia_actual_galones = v_nueva WHERE id_tanque = NEW.id_tanque;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_aplicar_movimiento_inventario
BEFORE INSERT ON movimientos_inventario
FOR EACH ROW EXECUTE FUNCTION fn_aplicar_movimiento_inventario();

-- Serializa cada movimiento del tanque con el cierre de su estación/día.
-- Todas las fechas operacionales del libro se guardan como UTC sin zona.
CREATE OR REPLACE FUNCTION fn_bloquear_movimiento_dia_cerrado()
RETURNS TRIGGER AS $$
DECLARE
    v_estacion_id BIGINT;
BEGIN
    NEW.fecha_hora := timezone('UTC', transaction_timestamp());
    SELECT id_estacion INTO v_estacion_id FROM tanques WHERE id_tanque = NEW.id_tanque;
    IF v_estacion_id IS NULL THEN
        RAISE EXCEPTION 'Tanque inexistente para registrar movimiento';
    END IF;

    PERFORM 1 FROM estaciones WHERE id_estacion = v_estacion_id FOR UPDATE;
    IF EXISTS (SELECT 1 FROM cierres_diarios WHERE id_estacion = v_estacion_id AND fecha = NEW.fecha_hora::DATE) THEN
        RAISE EXCEPTION 'El día operacional ya está cerrado para la estación %', v_estacion_id;
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_00_bloquear_movimiento_dia_cerrado
BEFORE INSERT ON movimientos_inventario
FOR EACH ROW EXECUTE FUNCTION fn_bloquear_movimiento_dia_cerrado();

-- 10.4 Puente automático: un despacho SIEMPRE genera su movimiento de
-- salida, y marca el ticket como consumido. Así nadie tiene que acordarse
-- de insertar en movimientos_inventario a mano desde el backend.
CREATE OR REPLACE FUNCTION fn_validar_transicion_estado_ticket()
RETURNS TRIGGER AS $$
DECLARE
    v_ahora_utc TIMESTAMP := clock_timestamp() AT TIME ZONE 'UTC';
BEGIN
    IF NEW.estado = OLD.estado THEN
        RETURN NEW;
    END IF;

    IF NEW.estado = 'ANULADO'
       AND OLD.estado IN ('CREADO','ENVIADO','PENDIENTE','PROXIMO_A_VENCER','VENCIDO') THEN
        IF NEW.anulado_en IS NULL OR NEW.id_usuario_anulacion IS NULL
           OR NEW.motivo_anulacion IS NULL OR length(btrim(NEW.motivo_anulacion)) = 0
           OR length(NEW.motivo_anulacion) > 500 THEN
            RAISE EXCEPTION 'La anulación requiere usuario, fecha y motivo (1 a 500 caracteres)';
        END IF;
        RETURN NEW;
    END IF;

    IF NEW.estado = 'PENDIENTE'
       AND OLD.estado IN ('CREADO','ENVIADO','PENDIENTE','PROXIMO_A_VENCER')
       AND EXISTS (SELECT 1 FROM envios_ticket WHERE id_ticket = OLD.id_ticket AND estado_envio = 'PENDIENTE') THEN
        RETURN NEW;
    END IF;

    IF NEW.estado = 'ENVIADO'
       AND OLD.estado = 'PENDIENTE'
       AND EXISTS (SELECT 1 FROM envios_ticket WHERE id_ticket = OLD.id_ticket)
       AND NOT EXISTS (
           SELECT 1 FROM (
               SELECT DISTINCT ON (canal) estado_envio
               FROM envios_ticket WHERE id_ticket = OLD.id_ticket
               ORDER BY canal, intento DESC
           ) ultimos
           WHERE estado_envio <> 'ENVIADO'
       ) THEN
        RETURN NEW;
    END IF;

    IF NEW.estado = 'CONSUMIDO'
       AND OLD.estado IN ('CREADO','ENVIADO','PENDIENTE','PROXIMO_A_VENCER')
       AND OLD.fecha_vencimiento > v_ahora_utc
       AND NEW.consumido_en IS NOT NULL
       AND EXISTS (SELECT 1 FROM despachos WHERE id_ticket = OLD.id_ticket) THEN
        RETURN NEW;
    END IF;

    RAISE EXCEPTION 'Transición inválida de ticket: % -> %', OLD.estado, NEW.estado;
END;
$$ LANGUAGE plpgsql;

DROP TRIGGER IF EXISTS trg_validar_transicion_estado_ticket ON tickets;
CREATE TRIGGER trg_validar_transicion_estado_ticket
BEFORE UPDATE OF estado ON tickets
FOR EACH ROW EXECUTE FUNCTION fn_validar_transicion_estado_ticket();

CREATE OR REPLACE FUNCTION fn_registrar_movimiento_por_despacho()
RETURNS TRIGGER AS $$
BEGIN
    INSERT INTO movimientos_inventario (id_tanque, tipo_movimiento, cantidad_galones, referencia_tipo, referencia_id, id_usuario)
    VALUES (NEW.id_tanque, 'SALIDA', NEW.galones_servidos, 'DESPACHO', NEW.id_despacho::TEXT, NEW.id_operador);

    UPDATE tickets SET estado = 'CONSUMIDO', consumido_en = NOW() WHERE id_ticket = NEW.id_ticket;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_despacho_movimiento
AFTER INSERT ON despachos
FOR EACH ROW EXECUTE FUNCTION fn_registrar_movimiento_por_despacho();

-- 10.5 Puente automático equivalente para recepciones de combustible.
CREATE OR REPLACE FUNCTION fn_registrar_movimiento_por_recepcion()
RETURNS TRIGGER AS $$
BEGIN
    INSERT INTO movimientos_inventario (id_tanque, tipo_movimiento, cantidad_galones, referencia_tipo, referencia_id, id_usuario)
    VALUES (NEW.id_tanque, 'ENTRADA', NEW.volumen_recibido_galones, 'RECEPCION', NEW.id_detalle::TEXT,
            (SELECT id_usuario_receptor FROM recepciones_combustible WHERE id_recepcion = NEW.id_recepcion));
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_recepcion_movimiento
AFTER INSERT ON detalle_recepciones
FOR EACH ROW EXECUTE FUNCTION fn_registrar_movimiento_por_recepcion();

-- El despacho y su movimiento usan el mismo instante UTC operacional.
ALTER TABLE despachos ALTER COLUMN fecha_hora SET DEFAULT (timezone('UTC', transaction_timestamp()));
ALTER TABLE movimientos_inventario ALTER COLUMN fecha_hora SET DEFAULT (timezone('UTC', transaction_timestamp()));

-- Un cierre es un acta histórica inmutable. TRUNCATE sigue disponible para el aislamiento QA.
CREATE OR REPLACE FUNCTION fn_cierre_diario_inmutable()
RETURNS TRIGGER AS $$
BEGIN
    RAISE EXCEPTION 'Los cierres diarios finalizados son inmutables';
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_cierre_diario_inmutable
BEFORE UPDATE OR DELETE ON cierres_diarios
FOR EACH ROW EXECUTE FUNCTION fn_cierre_diario_inmutable();

