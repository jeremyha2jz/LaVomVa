-- =====================================================================
-- BASE DE DATOS: Plataforma de Tickets Digitales e Inventario de Combustible
-- Basado en SRS Ticket Digitales v1.0 (Agosto 2026)
-- Motor: PostgreSQL 14+
-- Versión fusionada: combina el script inicial + el script alterno,
-- corrigiendo los huecos encontrados en ambos.
-- =====================================================================

CREATE EXTENSION IF NOT EXISTS pgcrypto;

-- =====================================================================
-- 1. CATÁLOGOS Y SEGURIDAD (RF-01, RS-01, RS-02)
-- =====================================================================

CREATE TABLE roles (
    id_role         BIGSERIAL PRIMARY KEY,
    nombre          VARCHAR(50) NOT NULL UNIQUE,
    descripcion     VARCHAR(200),
    activo          BOOLEAN NOT NULL DEFAULT TRUE,
    creado_en       TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE usuarios (
    id_usuario      BIGSERIAL PRIMARY KEY,
    nombre_usuario  VARCHAR(80) NOT NULL UNIQUE,
    correo          VARCHAR(150) NOT NULL UNIQUE,
    password_hash   TEXT NOT NULL,
    nombre_completo VARCHAR(150) NOT NULL,
    telefono        VARCHAR(25),
    activo          BOOLEAN NOT NULL DEFAULT TRUE,
    mfa_habilitado  BOOLEAN NOT NULL DEFAULT FALSE,
    ultimo_acceso   TIMESTAMP,
    creado_en       TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    actualizado_en  TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- Tabla puente: un usuario puede tener más de un rol (RBAC real)
CREATE TABLE usuario_roles (
    id_usuario      BIGINT NOT NULL REFERENCES usuarios(id_usuario) ON DELETE CASCADE,
    id_role         BIGINT NOT NULL REFERENCES roles(id_role) ON DELETE CASCADE,
    asignado_en     TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (id_usuario, id_role)
);

-- =====================================================================
-- 2. ESTRUCTURA ORGANIZACIONAL (RF-02, RF-03, RF-04)
-- =====================================================================

CREATE TABLE departamentos (
    id_departamento BIGSERIAL PRIMARY KEY,
    codigo          VARCHAR(20) UNIQUE,
    nombre          VARCHAR(100) NOT NULL UNIQUE,
    descripcion     VARCHAR(250),
    activo          BOOLEAN NOT NULL DEFAULT TRUE,
    creado_en       TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE empleados (
    id_empleado     BIGSERIAL PRIMARY KEY,
    codigo_empleado VARCHAR(30) NOT NULL UNIQUE,
    nombre_completo VARCHAR(150) NOT NULL,
    cedula          VARCHAR(20) NOT NULL UNIQUE,
    id_departamento BIGINT NOT NULL REFERENCES departamentos(id_departamento),
    cargo           VARCHAR(100),
    correo          VARCHAR(150),
    telefono_movil  VARCHAR(25),
    activo          BOOLEAN NOT NULL DEFAULT TRUE,
    creado_en       TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    actualizado_en  TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE tipos_combustible (
    id_tipo_combustible BIGSERIAL PRIMARY KEY,
    nombre              VARCHAR(50) NOT NULL UNIQUE,
    descripcion         VARCHAR(150),
    activo              BOOLEAN NOT NULL DEFAULT TRUE
);

CREATE TABLE vehiculos (
    id_vehiculo         BIGSERIAL PRIMARY KEY,
    placa                VARCHAR(20) NOT NULL UNIQUE,
    ficha                VARCHAR(30) NOT NULL UNIQUE,
    marca                VARCHAR(60) NOT NULL,
    modelo               VARCHAR(60) NOT NULL,
    anio                 SMALLINT,
    tipo                 VARCHAR(60),
    id_departamento      BIGINT NOT NULL REFERENCES departamentos(id_departamento),
    capacidad_tanque_galones NUMERIC(10,2),
    odometro_km          NUMERIC(12,2) NOT NULL DEFAULT 0,
    activo               BOOLEAN NOT NULL DEFAULT TRUE,
    creado_en            TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    actualizado_en       TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT chk_vehiculo_anio CHECK (anio IS NULL OR anio BETWEEN 1900 AND 2200),
    CONSTRAINT chk_capacidad_tanque CHECK (capacidad_tanque_galones IS NULL OR capacidad_tanque_galones > 0),
    CONSTRAINT chk_odometro CHECK (odometro_km >= 0)
);

-- =====================================================================
-- 3. ESTACIONES, TANQUES Y PROVEEDORES (RF-14, RF-16)
-- =====================================================================

CREATE TABLE estaciones (
    id_estacion     BIGSERIAL PRIMARY KEY,
    nombre          VARCHAR(120) NOT NULL,
    ubicacion       VARCHAR(250),
    activo          BOOLEAN NOT NULL DEFAULT TRUE,
    creado_en       TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE tanques (
    id_tanque                  BIGSERIAL PRIMARY KEY,
    codigo                     VARCHAR(30) NOT NULL UNIQUE,
    nombre                     VARCHAR(100),
    id_estacion                BIGINT NOT NULL REFERENCES estaciones(id_estacion),
    id_tipo_combustible        BIGINT NOT NULL REFERENCES tipos_combustible(id_tipo_combustible),
    capacidad_galones          NUMERIC(12,2) NOT NULL,
    existencia_actual_galones  NUMERIC(12,2) NOT NULL DEFAULT 0,
    nivel_critico_galones      NUMERIC(12,2) NOT NULL DEFAULT 0,
    activo                     BOOLEAN NOT NULL DEFAULT TRUE,
    creado_en                  TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT chk_tanque_capacidad CHECK (capacidad_galones > 0),
    CONSTRAINT chk_tanque_existencia CHECK (existencia_actual_galones >= 0 AND existencia_actual_galones <= capacidad_galones),
    CONSTRAINT chk_tanque_nivel_critico CHECK (nivel_critico_galones >= 0)
);

CREATE TABLE proveedores (
    id_proveedor    BIGSERIAL PRIMARY KEY,
    rnc             VARCHAR(20) UNIQUE,
    nombre          VARCHAR(150) NOT NULL,
    telefono        VARCHAR(25),
    correo          VARCHAR(150),
    activo          BOOLEAN NOT NULL DEFAULT TRUE,
    creado_en       TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- =====================================================================
-- 4. SOLICITUDES DE COMBUSTIBLE (RF-05)
-- =====================================================================

CREATE TABLE solicitudes_combustible (
    id_solicitud                BIGSERIAL PRIMARY KEY,
    id_empleado                 BIGINT NOT NULL REFERENCES empleados(id_empleado),
    id_vehiculo                 BIGINT NOT NULL REFERENCES vehiculos(id_vehiculo),
    id_departamento             BIGINT NOT NULL REFERENCES departamentos(id_departamento),
    id_tipo_combustible         BIGINT NOT NULL REFERENCES tipos_combustible(id_tipo_combustible),
    cantidad_solicitada_galones NUMERIC(10,2) NOT NULL,
    cantidad_autorizada_galones NUMERIC(10,2),
    fecha_solicitud             TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    fecha_vencimiento           TIMESTAMP,
    tipo_solicitud               VARCHAR(20) NOT NULL DEFAULT 'MANUAL'
                                  CHECK (tipo_solicitud IN ('MANUAL','AUTOMATICA','RECURRENTE')),
    frecuencia                   VARCHAR(50),
    estado                       VARCHAR(20) NOT NULL DEFAULT 'PENDIENTE'
                                  CHECK (estado IN ('PENDIENTE','APROBADA','RECHAZADA','CANCELADA')),
    motivo                       TEXT,
    id_usuario_creador           BIGINT REFERENCES usuarios(id_usuario),
    id_usuario_aprobador         BIGINT REFERENCES usuarios(id_usuario),
    fecha_aprobacion             TIMESTAMP,
    creado_en                    TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    actualizado_en               TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT chk_solicitud_cantidad CHECK (cantidad_solicitada_galones > 0),
    CONSTRAINT chk_solicitud_autorizada CHECK (cantidad_autorizada_galones IS NULL OR cantidad_autorizada_galones > 0)
);

-- =====================================================================
-- 5. CONFIGURACIÓN Y TICKETS DIGITALES (RF-06, RF-07, RF-08, RF-10)
-- =====================================================================

-- Fila única de configuración para la numeración de tickets (con lock de
-- concurrencia en la función, para que dos despachos simultáneos no generen
-- el mismo número).
CREATE TABLE configuracion_tickets (
    id_configuracion    BIGSERIAL PRIMARY KEY,
    prefijo             VARCHAR(20) NOT NULL DEFAULT 'COM',
    reinicio_anual      BOOLEAN NOT NULL DEFAULT TRUE,
    secuencia_actual    BIGINT NOT NULL DEFAULT 0,
    anio_secuencia      INTEGER NOT NULL DEFAULT EXTRACT(YEAR FROM CURRENT_DATE),
    actualizado_en      TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

INSERT INTO configuracion_tickets (prefijo, reinicio_anual) VALUES ('COM', TRUE);

CREATE TABLE tickets (
    id_ticket                    UUID PRIMARY KEY DEFAULT gen_random_uuid(), -- RF-06: identificador único (UUID)
    id_solicitud                 BIGINT NOT NULL UNIQUE REFERENCES solicitudes_combustible(id_solicitud),
    numero_secuencial            VARCHAR(40) NOT NULL UNIQUE, -- RF-08: ej. COM-2026-000001
    id_empleado                  BIGINT NOT NULL REFERENCES empleados(id_empleado),
    id_vehiculo                  BIGINT NOT NULL REFERENCES vehiculos(id_vehiculo),
    id_departamento              BIGINT NOT NULL REFERENCES departamentos(id_departamento),
    id_tipo_combustible          BIGINT NOT NULL REFERENCES tipos_combustible(id_tipo_combustible),
    cantidad_autorizada_galones  NUMERIC(10,2) NOT NULL,
    fecha_creacion               TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    fecha_vencimiento            TIMESTAMP NOT NULL,
    estado                       VARCHAR(25) NOT NULL DEFAULT 'CREADO'
                                  CHECK (estado IN ('CREADO','ENVIADO','PENDIENTE','PROXIMO_A_VENCER','VENCIDO','CONSUMIDO','ANULADO')),
    -- Seguridad del QR (RF-07 / RS-04): hash de los datos protegidos + token + firma
    qr_hash                      VARCHAR(64) NOT NULL UNIQUE,
    qr_token                     TEXT NOT NULL UNIQUE,
    qr_firma                     TEXT,
    consumido_en                 TIMESTAMP,
    anulado_en                   TIMESTAMP,
    motivo_anulacion             TEXT,
    id_usuario_anulacion         BIGINT,
    id_usuario_emisor            BIGINT REFERENCES usuarios(id_usuario),
    ruta_pdf                     VARCHAR(255),
    creado_en                    TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT chk_ticket_cantidad CHECK (cantidad_autorizada_galones > 0),
    CONSTRAINT chk_ticket_fechas CHECK (fecha_vencimiento > fecha_creacion),
    CONSTRAINT fk_tickets_usuario_anulacion FOREIGN KEY (id_usuario_anulacion) REFERENCES usuarios(id_usuario)
);

-- Historial de envío por canal (RF-09). Se deja como bitácora aparte en vez
-- de un simple booleano en "tickets", para poder ver reintentos y fallos
-- de integración (RF-23: "Fallo de integración").
CREATE TABLE envios_ticket (
    id_envio        BIGSERIAL PRIMARY KEY,
    id_ticket       UUID NOT NULL REFERENCES tickets(id_ticket),
    canal           VARCHAR(20) NOT NULL CHECK (canal IN ('CORREO','SMS')),
    destino         VARCHAR(150) NOT NULL,
    estado_envio    VARCHAR(20) NOT NULL DEFAULT 'PENDIENTE'
                     CHECK (estado_envio IN ('PENDIENTE','ENVIADO','FALLIDO')),
    detalle_error   TEXT,
    fecha_envio     TIMESTAMP,
    intento         INTEGER NOT NULL DEFAULT 1 CHECK (intento > 0),
    lote_id         UUID NOT NULL DEFAULT gen_random_uuid(),
    proveedor       VARCHAR(80),
    resultado       TEXT,
    idempotency_key UUID NOT NULL DEFAULT gen_random_uuid(),
    solicitado_en   TIMESTAMP NOT NULL DEFAULT (timezone('UTC', transaction_timestamp())),
    CONSTRAINT uq_envio_ticket_canal_intento UNIQUE (id_ticket, canal, intento),
    CONSTRAINT uq_envio_ticket_idempotencia_canal UNIQUE (id_ticket, idempotency_key, canal)
);
CREATE UNIQUE INDEX uq_envio_ticket_canal_pendiente ON envios_ticket(id_ticket, canal) WHERE estado_envio = 'PENDIENTE';

-- =====================================================================
-- 6. DESPACHOS (RF-12, RF-13)
-- =====================================================================

-- UNIQUE en id_ticket: un ticket solo se puede despachar una vez.
-- Esto es lo que garantiza "no reutilizable" del RF-07 a nivel de base
-- de datos, sin necesitar una columna/bandera aparte.
CREATE TABLE despachos (
    id_despacho             BIGSERIAL PRIMARY KEY,
    id_ticket                UUID NOT NULL UNIQUE REFERENCES tickets(id_ticket),
    id_tanque                BIGINT NOT NULL REFERENCES tanques(id_tanque),
    id_estacion               BIGINT NOT NULL REFERENCES estaciones(id_estacion),
    id_operador                BIGINT NOT NULL REFERENCES usuarios(id_usuario),
    fecha_hora                 TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    galones_servidos           NUMERIC(10,2) NOT NULL,
    odometro_km                NUMERIC(12,2),
    identidad_confirmada       BOOLEAN NOT NULL DEFAULT FALSE,
    observaciones               TEXT,
    creado_en                   TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT chk_despacho_galones CHECK (galones_servidos > 0),
    CONSTRAINT chk_despacho_odometro CHECK (odometro_km IS NULL OR odometro_km >= 0)
);

-- =====================================================================
-- 7. RECEPCIÓN E INVENTARIO (RF-14, RF-15, RF-16, RF-17)
-- =====================================================================

CREATE TABLE recepciones_combustible (
    id_recepcion         BIGSERIAL PRIMARY KEY,
    id_proveedor          BIGINT NOT NULL REFERENCES proveedores(id_proveedor),
    numero_factura         VARCHAR(60) NOT NULL,
    fecha_recepcion         TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    id_usuario_receptor     BIGINT NOT NULL REFERENCES usuarios(id_usuario),
    observaciones            TEXT,
    creado_en                TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- Una recepción/factura puede abastecer más de un tanque.
CREATE TABLE detalle_recepciones (
    id_detalle              BIGSERIAL PRIMARY KEY,
    id_recepcion              BIGINT NOT NULL REFERENCES recepciones_combustible(id_recepcion) ON DELETE CASCADE,
    id_tanque                 BIGINT NOT NULL REFERENCES tanques(id_tanque),
    volumen_recibido_galones  NUMERIC(12,2) NOT NULL,
    costo_unitario             NUMERIC(12,4),
    creado_en                  TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT chk_recepcion_volumen CHECK (volumen_recibido_galones > 0),
    CONSTRAINT chk_recepcion_costo CHECK (costo_unitario IS NULL OR costo_unitario >= 0)
);

-- Libro mayor de inventario: TODO movimiento de combustible pasa por aquí,
-- ya sea generado a mano (ajustes) o automáticamente por triggers desde
-- despachos y detalle_recepciones (ver sección 9).
CREATE TABLE movimientos_inventario (
    id_movimiento        BIGSERIAL PRIMARY KEY,
    id_tanque             BIGINT NOT NULL REFERENCES tanques(id_tanque),
    tipo_movimiento        VARCHAR(25) NOT NULL
                            CHECK (tipo_movimiento IN ('ENTRADA','SALIDA','AJUSTE_POSITIVO','AJUSTE_NEGATIVO','TRANSFERENCIA_ENTRADA','TRANSFERENCIA_SALIDA','MERMA')),
    cantidad_galones        NUMERIC(12,2) NOT NULL,
    existencia_anterior      NUMERIC(12,2),
    existencia_nueva          NUMERIC(12,2),
    referencia_tipo            VARCHAR(40), -- 'DESPACHO','RECEPCION','AJUSTE_MANUAL'
    referencia_id                VARCHAR(100),
    motivo                        TEXT,
    id_usuario                    BIGINT REFERENCES usuarios(id_usuario),
    fecha_hora                     TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    creado_en                       TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT chk_movimiento_cantidad CHECK (cantidad_galones > 0)
);

-- =====================================================================
-- 8. CIERRES DIARIOS (RF-18)
