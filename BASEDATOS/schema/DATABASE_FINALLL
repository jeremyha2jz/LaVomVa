CREATE OR REPLACE VIEW vw_tickets_detalle AS
SELECT
    t.id_ticket, t.numero_secuencial, t.estado, t.fecha_creacion, t.fecha_vencimiento,
    e.codigo_empleado, e.nombre_completo AS empleado,
    v.placa, v.ficha,
    d.nombre AS departamento,
    tc.nombre AS tipo_combustible,
    t.cantidad_autorizada_galones
FROM tickets t
JOIN empleados e ON e.id_empleado = t.id_empleado
JOIN vehiculos v ON v.id_vehiculo = t.id_vehiculo
JOIN departamentos d ON d.id_departamento = t.id_departamento
JOIN tipos_combustible tc ON tc.id_tipo_combustible = t.id_tipo_combustible;

CREATE OR REPLACE VIEW vw_inventario_actual AS
SELECT
    ta.id_tanque, ta.codigo AS tanque, es.nombre AS estacion, tc.nombre AS tipo_combustible,
    ta.capacidad_galones, ta.existencia_actual_galones, ta.nivel_critico_galones,
    CASE WHEN ta.existencia_actual_galones <= ta.nivel_critico_galones THEN 'CRITICO' ELSE 'NORMAL' END AS estado_inventario
FROM tanques ta
JOIN estaciones es ON es.id_estacion = ta.id_estacion
JOIN tipos_combustible tc ON tc.id_tipo_combustible = ta.id_tipo_combustible;

CREATE OR REPLACE VIEW vw_tickets_alerta AS
SELECT
    id_ticket, numero_secuencial, id_empleado, id_vehiculo, fecha_vencimiento, estado,
    CASE
        WHEN fecha_vencimiento <= (NOW() AT TIME ZONE 'UTC') AND estado NOT IN ('CONSUMIDO','ANULADO') THEN 'VENCIDO'
        WHEN fecha_vencimiento <= (NOW() AT TIME ZONE 'UTC') + INTERVAL '2 days' AND estado NOT IN ('CONSUMIDO','ANULADO') THEN 'PROXIMO_A_VENCER'
        ELSE estado
    END AS estado_calculado
FROM tickets;

CREATE OR REPLACE VIEW vw_consumo_por_departamento AS
SELECT dep.id_departamento, dep.nombre AS departamento, COALESCE(SUM(d.galones_servidos), 0) AS total_galones_despachados
FROM departamentos dep
LEFT JOIN tickets t ON t.id_departamento = dep.id_departamento
LEFT JOIN despachos d ON d.id_ticket = t.id_ticket
GROUP BY dep.id_departamento, dep.nombre;

CREATE OR REPLACE VIEW vw_consumo_por_vehiculo AS
SELECT v.id_vehiculo, v.placa, v.ficha, COALESCE(SUM(d.galones_servidos), 0) AS total_galones_despachados
FROM vehiculos v
LEFT JOIN tickets t ON t.id_vehiculo = v.id_vehiculo
LEFT JOIN despachos d ON d.id_ticket = t.id_ticket
GROUP BY v.id_vehiculo, v.placa, v.ficha;

