    observaciones                                TEXT,
    cerrado_en                                    TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    inventario_fisico_galones                    NUMERIC(12,2) NOT NULL DEFAULT 0,
    cantidad_despachos                            INTEGER NOT NULL DEFAULT 0 CHECK (cantidad_despachos >= 0),
    estado                                        VARCHAR(20) NOT NULL DEFAULT 'CERRADO' CHECK (estado = 'CERRADO'),
