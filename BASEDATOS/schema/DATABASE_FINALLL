CREATE TABLE cierres_diarios (
    id_cierre                        BIGSERIAL PRIMARY KEY,
    id_estacion                       BIGINT NOT NULL REFERENCES estaciones(id_estacion),
    fecha                              DATE NOT NULL,
    inventario_inicial_galones          NUMERIC(12,2) NOT NULL DEFAULT 0,
